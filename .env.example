# Copy to `.env` in the repo root (backend reads `../.env`) or alongside run.py,
# fill in real values, and keep it OUT of version control.

# ── Required: Telegram ──────────────────────────────────────────────────────
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token
# Channel where the bot stores/streams media (a supergroup/channel you own)
TELEGRAM_STORAGE_CHANNEL_ID=-1001234567890

# ── Optional: extra bots for parallel fetching (comma-separated) ────────────
# TELEGRAM_HELPER_BOT_TOKENS=token1,token2,token3
# TELEGRAM_BOT_SESSION_STRINGS=session1,session2

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_USERS=your_telegram_id
ADMIN_IDS=your_telegram_id
# Run `openssl rand -hex 32` and set this so sessions survive restarts
JWT_SECRET=your_jwt_secret

# ── Database (SQLite default; PostgreSQL supported) ────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=7680
# Public URL of the web app (your domain / tunnel). The Android app defaults to
# http://localhost:7680 — set this when exposing the backend publicly.
WEB_BASE_URL=http://localhost:7680

# ── Streaming engine / cache (tune these) ───────────────────────────────────
# Chunks per read batch
STREAM_BATCH_SIZE=10
# Max concurrent stream workers
STREAM_MAX_CONCURRENT=4
# Per-video RAM hot cache (MB)
STREAM_RAM_PER_VIDEO_MB=300
# In-flight / backpressure cap per stream (MB)
STREAM_INFLIGHT_MB=200
# How far ahead the prefetcher runs (MB)
STREAM_PREFETCH_AHEAD_MB=192
# Bots used for ahead-prefetching
STREAM_PREFETCH_CONCURRENCY=3
# Stop prefetching past this many concurrent active streams
STREAM_PREFETCH_MAX_STREAMS=6
# Wall-clock budget per batch (seconds)
STREAM_BATCH_TIMEOUT_S=30
# Abort a batch if no progress for this long (seconds)
STREAM_BATCH_STALL_S=15
# Single-chunk fetch budget (seconds)
STREAM_CHUNK_TIMEOUT_S=15
# Queue-wait budget behind a busy bot (seconds)
STREAM_SEM_WAIT_TIMEOUT_S=10
# Per-bot pipelined fetch concurrency
TELEGRAM_CLIENT_CONCURRENCY=8

# ── Disk cache (second tier, survives restarts) ─────────────────────────────
# DISK_CACHE_DIR=./data/vcache
# DISK_CACHE_ENABLED=1
# DISK_CACHE_TTL=1800
# DISK_CACHE_MAX_BYTES=8589934592          # 8 GB total
# DISK_CACHE_PER_VIDEO_BYTES=2147483648    # 2 GB per video

# ── Optimized (positions the engine's timeouts; leave as-is unless tuning) ──
# STREAM_MEM_PRESSURE_RATIO=0.6

# ── Subtitles (optional) ────────────────────────────────────────────────────
# Default subtitle language(s), comma-separated IETF tags
SUBTITLE_LANGUAGES=en
# Keyless subtitle providers. OpenSubtitles.com is added automatically when
# the API key is set.
SUBTITLE_PROVIDERS=podnapisi,tvsubtitles,addic7ed
# OpenSubtitles.com free tier: key alone enables search + 5 downloads/day.
OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# ── Grab / movie search (optional) ─────────────────────────────────────────
# GRAB_GROUP_USERNAMES=my_movie_group1,my_movie_group2
# GRAB_BOT_USERNAMES=AutoFilterBot,
# GRAB_SESSION_STRINGS=session_string1,session_string2

# ── Google Drive (optional) ────────────────────────────────────────────────
# GDRIVE_CLIENT_ID=your_gdrive_client_id
# GDRIVE_CLIENT_SECRET=your_gdrive_client_secret
# GDRIVE_REDIRECT_URI=http://localhost:7680/api/gdrive/auth/callback

# ── Misc ────────────────────────────────────────────────────────────────────
# MT_PROXY_URL=socks5://user:pass@host:1080
# CLOUDFLARE_API_TOKEN=your_cf_token
# DEBUG_PASSWORD=   # enables /api/diag/* diagnostic endpoints